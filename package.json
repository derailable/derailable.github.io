{
  "name": "derailable-podcast-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "vp check && npm run build && html-validate 'dist/**/*.html' && node scripts/check.mjs",
    "dev": "npm run build && vp preview",
    "preview": "vp preview",
    "prepare": "vp config",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "html-validate": "11.17.0",
    "marked": "18.1.1",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.8.0"
  }
}
